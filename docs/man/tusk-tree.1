.nh
.TH "TUSK-TREE" "1" "Sep 2026" "Tusk" "Tusk Manual"

.SH NAME
tusk-tree - Show the forest or a complete subtree


.SH SYNOPSIS
\fBtusk tree [id] [flags]\fP


.SH DESCRIPTION
Show the forest or a complete subtree


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for tree

.PP
\fB--json\fP[=false]
	Print complete JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--auto-complete-parent\fP[=false]
	Complete parents when all children are done

.PP
\fB--timezone\fP=""
	Date timezone (IANA name)


.SH EXAMPLE
.EX
  tusk tree TASK_ID --json
.EE


.SH SEE ALSO
\fBtusk(1)\fP
