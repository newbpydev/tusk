+func TestOpen_RetainedReaderCloseFailure(t *testing.T) {
+	var opened, closed atomic.Int32
+	factory := func(path string, role connectionRole) (driver.Connector, error) {
+		base, err := connectorFor(path, role)
+		if err != nil {
+			return nil, err
+		}
+		stage := ""
+		if role == inspectionConnection {
+			stage = "close"
+		}
+		return openFaultConnector{base, stage, &opened, &closed}, nil
+	}
+	r, err := openAt(context.Background(), filepath.Join(t.TempDir(), "close.db"), factory, prepareFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Close(); err == nil {
+		t.Fatal("retained reader close failure lost")
+	}
+	if opened.Load() != closed.Load() {
+		t.Fatalf("opened %d closed %d", opened.Load(), closed.Load())
+	}
+}
