+func TestOpen_ReusesInspectedReader(t *testing.T) {
+	var opened, closed atomic.Int32
+	factory := func(path string, role connectionRole) (driver.Connector, error) {
+		base, err := connectorFor(path, role)
+		if err != nil {
+			return nil, err
+		}
+		return openFaultConnector{base, "", &opened, &closed}, nil
+	}
+	path := filepath.Join(t.TempDir(), "reuse.db")
+	for range 2 { // First-use migration and an existing WAL database.
+		opened.Store(0)
+		closed.Store(0)
+		r, err := openAt(context.Background(), path, factory, prepareFile)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var count int
+		if err := r.reader.QueryRow("SELECT count(*) FROM tasks").Scan(&count); err != nil || count != 0 {
+			t.Fatalf("reader after migration: %d %v", count, err)
+		}
+		if _, err := r.reader.Exec("DELETE FROM tasks"); err == nil {
+			t.Fatal("reader permits writes")
+		}
+		if err := r.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if opened.Load() != 2 || closed.Load() != opened.Load() {
+			t.Fatalf("physical connections opened=%d closed=%d; want exactly reader and writer", opened.Load(), closed.Load())
+		}
+	}
+}
